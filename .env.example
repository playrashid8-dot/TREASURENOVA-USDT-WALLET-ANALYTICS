# =============================================================================
# TreasureNOVA USDT Wallet Analytics — Environment Variables
# Copy this file to .env.local and fill in values before running.
# =============================================================================

# Public
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_APP_NAME=TreasureNOVA USDT Wallet Analytics
NEXT_PUBLIC_EXPLORER_URL=https://bscscan.com

# BNB Smart Chain RPC (required for balances + chain health; archive getLogs optional)
# Public dataseeds often lack eth_getLogs — historical sync prefers SQD Portal, with RPC fallback.
BSC_RPC_URL=https://bsc.publicnode.com

# BEP-20 USDT contract on BNB Smart Chain (REQUIRED — do not leave blank in production)
# Verify with: npm run verify:token
USDT_CONTRACT_ADDRESS=

# Monitored wallets (read-only analytics)
DEPOSIT_WALLET=0xc051a1b111085ddD6Bc2FF8346Ad0f4E7dF26935
WITHDRAW_WALLET=0x48A909049FB00581CA83beA39BB824eBb90132FA

# Reserve fund wallet (live balanceOf + Reserve OUT indexed for Recent TX History)
RESERVE_FUND_WALLET=0xe1ce23017882f3630e2B5dC4f2Fb3f33947E5904

# Optional: Etherscan API (kept for compatibility; historical sync uses BSC RPC)
# Get a key at https://etherscan.io/apikey
ETHERSCAN_API_KEY=

# Supabase (server uses secret key; publishable key is for optional realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Sync
SYNC_INTERVAL_SECONDS=20
HISTORICAL_BATCH_SIZE=1000
# Display-only floor for optional transaction list tooling (stats stay unfiltered)
MIN_DISPLAY_USDT_AMOUNT=50
# Recent Large Transactions section only. The main Recent TX feed shows every USDT transfer.
LARGE_TX_MIN_USDT=10000
LARGE_TX_COMPLETED_DAYS=5
# First-time eth_getLogs lower bound (USDT deployment-era on BSC). Resume uses sync_state.
SYNC_START_BLOCK=6982962
# Preferred eth_getLogs chunk size for RPC fallback (adapts automatically; max ~9999 on many RPCs)
LOG_SCAN_CHUNK_SIZE=9999
# First sync / --full lookback window (blocks). Set 0 to scan from SYNC_START_BLOCK.
SYNC_LOOKBACK_BLOCKS=900000
# Optional: auto | sqd | rpc. Incremental and near-head sync always use BSC RPC eth_getLogs.
# auto = SQD for deep history, then RPC if the indexer returns empty/204 or is behind.
# LOG_SCAN_SOURCE=auto
# SQD_PORTAL_URL=https://portal.sqd.dev/datasets/binance-mainnet/stream
# SQD_SCAN_WINDOW=100000

# Protect /api/sync. Vercel Cron calls GET /api/sync with Bearer CRON_SECRET.
# Set CRON_SECRET equal to SYNC_SECRET, or set both.
SYNC_SECRET=
# CRON_SECRET=
